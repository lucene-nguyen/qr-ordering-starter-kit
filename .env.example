# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API). Publishable key is safe in the browser;
# Row Level Security is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Used by Server Actions for trusted writes. Never expose to the client.
SUPABASE_SECRET_KEY=

# Restaurant timezone for reports
APP_TIMEZONE=Asia/Ho_Chi_Minh
